<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Dashboard</title>
</head>
<body>
    <!-- A .phtml view template: the HTML shell is literal output (non-code),
         and every dynamic value is escaped through htmlspecialchars before it
         is printed, so a precise scanner fires nothing. -->
    <h1>Welcome</h1>
    <p>Signed in as <?= htmlspecialchars($currentUser, ENT_QUOTES, 'UTF-8') ?></p>
    <ul>
        <?php foreach ($items as $item): ?>
            <li><?= htmlspecialchars($item['label'], ENT_QUOTES, 'UTF-8') ?></li>
        <?php endforeach; ?>
    </ul>
</body>
</html>
