# Auto-detect text files and normalize line endings
* text=auto

# Go source files
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# Shell scripts
*.sh text eol=lf

# Config files
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf

# Documentation
*.md text eol=lf

# Proto definitions
*.proto text eol=lf

# Dockerfile
Dockerfile text eol=lf

# Windows-specific
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.svg binary
*.woff binary
*.woff2 binary
